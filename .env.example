# Скопируйте в .env и заполните. .env в git не коммитится.

# --- LLM ---
LLM_PROVIDER=openai            # openai | yandex | gigachat | anthropic
LLM_MODEL=gpt-4.1-mini

OPENAI_API_KEY=
OPENAI_BASE_URL=               # пусто для OpenAI; для OpenAI-совместимых шлюзов — их URL

YANDEX_API_KEY=                # Yandex AI Studio
YANDEX_FOLDER_ID=

GIGACHAT_CREDENTIALS=          # ключ авторизации GigaChat API
GIGACHAT_SCOPE=GIGACHAT_API_PERS

ANTHROPIC_API_KEY=

# --- Telegram (этап 4) ---
TG_TOKEN_SALES=
TG_TOKEN_SERVICE=
TG_TOKEN_HR=

# Чаты отделов для карточек передачи (этап 2)
TG_CHAT_SALES=
TG_CHAT_SERVICE=
TG_CHAT_SERVICE_HEAD=
TG_CHAT_HR=

# --- Хранилище ---
DB_PATH=data/app.sqlite3
