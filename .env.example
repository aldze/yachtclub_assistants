# Скопируйте в .env и заполните. .env в git не коммитится.
# Комментарий к пустому значению — только отдельной строкой: Docker compose прочитает
# «KEY=   # текст» как значение «# текст».

# --- LLM ---
LLM_PROVIDER=openai            # openai | yandex | gigachat | anthropic
LLM_MODEL=gpt-4.1-mini
JUDGE_MODEL=gpt-4.1-mini        # модель LLM-судьи для eval (этап 3); для прода — gpt-4.1
LLM_MAX_RETRIES=5              # повторы при лимите запросов (429) и сбоях провайдера
# пусто — как в config/assistants.yaml (stuffing); rag — поиск по базе знаний (этап 5)
RETRIEVAL=
EMBED_MODEL=text-embedding-3-small  # модель эмбеддингов для rag

OPENAI_API_KEY=
# пусто для OpenAI; для OpenAI-совместимых шлюзов — их URL
OPENAI_BASE_URL=

# Yandex AI Studio
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# ключ авторизации GigaChat API
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

ANTHROPIC_API_KEY=

# --- Telegram (этап 4) ---
# бот единого окна (python -m app.channels.telegram)
TG_TOKEN_WINDOW=
TG_TOKEN_SALES=
TG_TOKEN_SERVICE=
TG_TOKEN_HR=

# Чаты отделов для карточек передачи (этап 2). Пусто — карточка печатается в консоль.
# Бот, который пишет в чаты отделов; пусто — используется TG_TOKEN_<ассистент>.
TG_NOTIFY_TOKEN=
TG_CHAT_SALES=
TG_CHAT_SERVICE=
TG_CHAT_SERVICE_HEAD=
TG_CHAT_HR=

# --- Хранилище ---
DB_PATH=data/app.sqlite3

# --- Веб-виджет (этап 4) ---
WEB_HOST=127.0.0.1
WEB_PORT=8080
# сайты, где встроен виджет, через запятую: https://example.ru
WEB_ALLOWED_ORIGINS=
WEB_RATE_LIMIT=30/600           # запросов с одного IP за 600 секунд
WEB_DAILY_LIMIT=1500            # реплик в сутки на весь сервис (защита баланса); 0 — без лимита
# 1 — за обратным прокси (в docker-compose задано само)
WEB_TRUST_PROXY=

# --- Деплой (этап 6, docs/DEPLOY.md) ---
# домен сервера, например chat.example.ru; пусто — localhost
DOMAIN=
# чат для оповещений об ошибках (бот — TG_NOTIFY_TOKEN)
TG_ALERT_CHAT=

LOG_LEVEL=INFO
