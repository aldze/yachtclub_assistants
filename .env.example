# Скопируйте в .env и заполните. .env в git не коммитится.

# --- LLM ---
LLM_PROVIDER=openai            # openai | yandex | gigachat | anthropic
LLM_MODEL=gpt-4.1-mini
JUDGE_MODEL=gpt-4.1-mini        # модель LLM-судьи для eval (этап 3); для прода — gpt-4.1
LLM_MAX_RETRIES=5              # повторы при лимите запросов (429) и сбоях провайдера

OPENAI_API_KEY=
OPENAI_BASE_URL=               # пусто для OpenAI; для OpenAI-совместимых шлюзов — их URL

YANDEX_API_KEY=                # Yandex AI Studio
YANDEX_FOLDER_ID=

GIGACHAT_CREDENTIALS=          # ключ авторизации GigaChat API
GIGACHAT_SCOPE=GIGACHAT_API_PERS

ANTHROPIC_API_KEY=

# --- Telegram (этап 4) ---
TG_TOKEN_WINDOW=                # бот единого окна (python -m app.channels.telegram)
TG_TOKEN_SALES=
TG_TOKEN_SERVICE=
TG_TOKEN_HR=

# Чаты отделов для карточек передачи (этап 2). Пусто — карточка печатается в консоль.
# Бот, который пишет в чаты отделов; пусто — используется TG_TOKEN_<ассистент>.
TG_NOTIFY_TOKEN=
TG_CHAT_SALES=
TG_CHAT_SERVICE=
TG_CHAT_SERVICE_HEAD=
TG_CHAT_HR=

# --- Хранилище ---
DB_PATH=data/app.sqlite3

# --- Веб-виджет (этап 4) ---
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_ALLOWED_ORIGINS=            # сайты, где встроен виджет, через запятую: https://example.ru

LOG_LEVEL=INFO
